# Copy to Vercel Project Settings → Environment Variables (or a local .env for `vercel dev`).

# --- AI bill reader (/api/extract-bill) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# --- Leads CRM (Google Sheet) ---
# Spreadsheet already created for Kinmo PW leads:
#   https://docs.google.com/spreadsheets/d/1jYJNcAPHGtVyvdzVDFudAZXoMGHV8kT0KKUzUVduvE4/edit
GOOGLE_SHEETS_SPREADSHEET_ID=1jYJNcAPHGtVyvdzVDFudAZXoMGHV8kT0KKUzUVduvE4
# Optional sheet tab name (default Sheet1)
# GOOGLE_SHEETS_TAB=Sheet1

# Service account (preferred — enables /api/lead append + /crm list/update)
# 1) Create a GCP service account with Sheets API enabled
# 2) Download JSON key; put client_email and private_key here
# 3) Share the spreadsheet with the service-account email as Editor
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@project.iam.gserviceaccount.com
# Paste the full PEM including BEGIN/END lines. In Vercel, use literal \n for newlines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional append-only fallback if service account is not ready yet
# LEADS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec

# Password for /crm admin UI (never commit a real value)
CRM_ADMIN_PASSWORD=choose-a-strong-password

# Optional: extra allowed Origin host for API CORS checks (in addition to same host + *.vercel.app)
# ALLOWED_ORIGIN=www.example.com

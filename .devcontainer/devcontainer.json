{
  "name": "Solar Calculator PH (static site)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "index.html"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": []
    }
  },
  "postAttachCommand": {
    "server": "python3 -m http.server 8000"
  },
  "portsAttributes": {
    "8000": {
      "label": "Solar Calculator",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8000
  ]
}
